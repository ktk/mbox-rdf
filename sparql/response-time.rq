PREFIX mail: <https://mail.described.at/>
PREFIX schema: <http://schema.org/>

SELECT ?replier (SAMPLE(?name) AS ?displayName) (COUNT(?reply) AS ?replies) WHERE {
  ?reply mail:inReplyTo ?original ;
         mail:from ?replierAccount ;
         schema:dateCreated ?replyDate .
  ?original schema:dateCreated ?origDate ;
            mail:from ?origSender .
  FILTER(?replierAccount != ?origSender)
  FILTER(?replyDate > ?origDate)
  OPTIONAL { ?replierAccount schema:name ?name }
  BIND(?replierAccount AS ?replier)
}
GROUP BY ?replier
ORDER BY DESC(?replies)
LIMIT 20